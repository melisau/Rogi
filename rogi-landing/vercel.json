{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 45
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/tr",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index?rogi_route=:path*"
    }
  ]
}
