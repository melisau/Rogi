{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 45
    },
    "api/render.js": {
      "maxDuration": 45
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rogi-audit.vercel.app"
        }
      ],
      "destination": "https://rogi.melisauyar.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/tr",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index?rogi_route=:path*"
    }
  ]
}
